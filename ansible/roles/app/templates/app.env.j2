# {{ ansible_managed }}
# The app reads secret_key, contact_table, ses_sender and notify_email
# from SSM Parameter Store under this prefix, using the instance role.
SSM_PARAM_PREFIX={{ ssm_param_prefix }}
AWS_REGION={{ aws_region }}
BIND=127.0.0.1:{{ app_port }}
PROXY_HOPS=1
DATA_DIR={{ app_dir }}/data
APP_VERSION={{ app_version }}
